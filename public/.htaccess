<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 1. Block direct access to the data folder (where PHP stores JSON files)
  RewriteRule ^data/.*$ - [F,L]

  # 2. Route all API calls to api.php
  RewriteRule ^api/(.*)$ api.php?endpoint=$1 [QSA,L]
  RewriteRule ^api$ api.php [QSA,L]

  # 3. If the requested file or directory exists physically, serve it directly
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # 4. For all other routes, send to index.html (React Router SPA)
  RewriteRule ^ index.html [L]
</IfModule>

# Disable directory browsing
Options -Indexes
