<IfModule mod_mime.c>
  AddType application/javascript .js .mjs
  AddType text/css .css
  AddType application/json .json
  AddType image/svg+xml .svg
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 1. Block direct access to the data folder (where PHP stores JSON files)
  RewriteRule ^data/.*$ - [F,L]

  # 2. Route all API calls to api.php
  RewriteRule ^api/(.*)$ api.php?endpoint=$1 [QSA,L]
  RewriteRule ^api$ api.php [QSA,L]

  # 3. If the requested file or directory exists physically, serve it directly
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # 4. Never serve index.html (text/html) for missing assets or scripts - return 404
  RewriteCond %{REQUEST_URI} \.(js|mjs|css|json|webmanifest|png|jpg|jpeg|gif|ico|svg|woff|woff2|ttf|map)$ [NC]
  RewriteRule ^ - [R=404,L]

  # 5. For all other SPA client navigation routes, send to index.html
  RewriteRule ^ index.html [L]
</IfModule>

# Disable directory browsing
Options -Indexes
